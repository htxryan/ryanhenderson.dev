# ryanhenderson.dev — environment variables (E9 — U-23).
#
# Copy this file to `.env.local` for local use; `.env.local` is gitignored.
# Set the same variables in the Cloudflare Pages dashboard for production
# and preview deploys (Settings → Environment variables).
#
# Nothing in this file should ever contain a real secret. The values below
# are documentation only.

# --- Site identity ---------------------------------------------------------

# Canonical origin used by Astro for absolute URLs (canonical, og:url, RSS,
# sitemap). Must match the bound custom domain in production. The value in
# astro.config.mjs takes precedence; this is here for any script that wants
# to reach the same value at runtime.
PUBLIC_SITE_URL=https://ryanhenderson.dev

# --- Cloudflare Web Analytics ---------------------------------------------

# Beacon token from CF dashboard → Analytics & Logs → Web Analytics → site.
# CF Web Analytics tokens are designed to ship in HTML; treat as low-secret.
# When unset, the beacon is omitted from the build (dev convenience).
CF_WEB_ANALYTICS_TOKEN=

# --- Cloudflare API (provisioning script only) ----------------------------

# Required ONLY for `pnpm provision:cf`. CF Pages does NOT need these to
# build/deploy — the deploy gate is `pnpm install --frozen-lockfile && pnpm build`,
# nothing more. Token MUST be scoped:
#   • Zone:DNS:Edit  for the `ryanhenderson.dev` zone ONLY
#   • Account:Cloudflare Pages:Edit  for the `ryanhenderson-dev` project ONLY
# Anything broader is a footgun. See docs/runbooks/dns.md.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# Project + record targets used by the provisioning script. Defaults match
# the production environment; override only when bootstrapping a fork.
CF_PAGES_PROJECT=ryanhenderson-dev
CF_APEX_DOMAIN=ryanhenderson.dev
CF_WWW_HOSTNAME=www.ryanhenderson.dev

# --- Provided by Cloudflare Pages at build time (do not set locally) ------
#
# CF_PAGES_BRANCH    — git branch being built (used by some _headers
#                      preview-vs-prod logic and analytics tagging)
# CF_PAGES_URL       — preview/production URL of the current build
# CF_PAGES_COMMIT_SHA
