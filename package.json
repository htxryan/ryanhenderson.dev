{
  "name": "ryanhenderson-dev",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check:content-source && pnpm check:content-slugs && pnpm gen:tokens && astro build && pagefind --site dist && pnpm check:csp-hashes",
    "deploy": "pnpm install --frozen-lockfile && pnpm build",
    "gen:tokens": "node scripts/generate-tokens-css.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:content-source": "node scripts/check-content-helpers.mjs",
    "check:content-slugs": "node scripts/check-content-slugs.mjs",
    "check:csp-hashes": "node scripts/check-csp-hashes.mjs",
    "provision:cf": "node --experimental-strip-types scripts/provision-cf.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:iv": "vitest run && playwright test",
    "test:lhci": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.2.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.6.1",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.10.5",
    "axe-core": "^4.11.4",
    "compound-agent": "^2.7.2",
    "fast-xml-parser": "^5.7.2",
    "jsdom": "^29.1.1",
    "pagefind": "^1.5.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
