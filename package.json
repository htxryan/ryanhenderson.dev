{
  "name": "ryanhenderson-dev",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check:content-source && pnpm check:content-slugs && pnpm gen:tokens && astro build && pagefind --site dist && pnpm check:csp-hashes",
    "deploy": "pnpm install --frozen-lockfile && pnpm build",
    "gen:tokens": "node scripts/generate-tokens-css.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:content-source": "node scripts/check-content-helpers.mjs",
    "check:content-slugs": "node scripts/check-content-slugs.mjs",
    "check:csp-hashes": "node scripts/check-csp-hashes.mjs",
    "provision:cf": "node --experimental-strip-types scripts/provision-cf.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:iv": "vitest run && playwright test",
    "test:lhci": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.2.1",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.12.1",
    "compound-agent": "^2.12.1",
    "fast-xml-parser": "^5.9.3",
    "jsdom": "^29.1.1",
    "pagefind": "^1.5.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "fast-xml-builder": ">=1.1.7",
      "fast-uri": ">=3.1.2"
    }
  }
}
