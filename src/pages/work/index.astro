---
/**
 * Portfolio index (`/work/`).
 *
 * Lists every published project, ordered by status (active → coming-soon
 * → archived → private). `private` is filtered out by
 * `getPublishedProjects()` (the single filter authority, C-2). The build
 * gate `pnpm check:content-source` enforces that this route never bypasses
 * the helper.
 *
 * Card markup is shared with the home page via <ProjectCard />, but the
 * home page no longer lists projects (it shows only landing-style links to
 * /about/ and /work/), so this is currently the sole consumer.
 *
 * Performance: zero client JS shipped from this route (W-1).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import { getPublishedProjects } from "~/lib/content";

const projects = await getPublishedProjects();
---
<BaseLayout
  title="Work — Ryan Henderson"
  description="Projects I'm building — solo OSS and SaaS work."
  canonicalPath="/work/"
>
  <section class="archive" aria-labelledby="archive-heading">
    <header class="archive-header">
      <h1 id="archive-heading">Work</h1>
    </header>
    {projects.length === 0 ? (
      <p class="empty">No projects yet.</p>
    ) : (
      <ul class="cards" role="list">
        {projects.map((project) => (
          <li class="cards-item">
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .archive-header {
    border-bottom: calc(var(--rule-hairline) * 2) solid var(--rule-color);
    padding-bottom: calc(var(--space-unit) * 2);
    margin-bottom: calc(var(--space-unit) * 4);
  }
  .archive-header h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw + 1rem, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--space-unit) * 2);
    max-width: var(--measure);
  }
  .cards-item {
    display: block;
  }
  .empty {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }
</style>
