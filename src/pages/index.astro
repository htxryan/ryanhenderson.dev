---
/**
 * Home (S-1).
 *
 * Brutalist composition:
 *   - Hairline-ruled hero block with name + one-line positioning
 *   - Featured work grid below
 *
 * Writing/blog is currently hidden — when it returns, restore the
 * asymmetric two-column grid (Recent writing | Featured work) from git.
 *
 * Data: pulled exclusively through E1's helpers (C-2). No direct
 * `getCollection` here — the build will fail via `pnpm check:content-source`
 * if anyone reverts that.
 *
 * Performance: zero client JS shipped from this page (W-1). The only script
 * on first load is the inline ThemeBoot inside <head>.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import { getPublishedProjects } from "~/lib/content";
import { SITE_NAME, SITE_TAGLINE } from "~/lib/site-meta";

const featuredProjects = (await getPublishedProjects()).slice(0, 6);
---
<BaseLayout
  title="ryanhenderson.dev"
  description={`${SITE_NAME} — ${SITE_TAGLINE}. Selected work and projects.`}
  canonicalPath="/"
>
  <section class="hero" aria-labelledby="hero-name">
    <h1 id="hero-name" class="hero-name">{SITE_NAME}</h1>
    <p class="hero-tag">
      {SITE_TAGLINE}. <a href="/about/">More about me →</a>
    </p>
  </section>

  <section class="column" aria-labelledby="work-heading">
    <header class="column-header">
      <h2 id="work-heading">Featured work</h2>
      <a class="column-more" href="/work/">all work →</a>
    </header>
    {featuredProjects.length === 0 ? (
      <p class="empty">No projects yet.</p>
    ) : (
      <ul class="cards" role="list">
        {featuredProjects.map((project) => (
          <li class="cards-item">
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    border-top: var(--rule-hairline) solid var(--rule-color);
    border-bottom: var(--rule-hairline) solid var(--rule-color);
    padding: calc(var(--space-unit) * 6) 0;
    margin-bottom: calc(var(--space-unit) * 4);
  }
  .hero-name {
    margin: 0 0 calc(var(--space-unit) * 2);
    font-size: clamp(2.5rem, 6vw + 1rem, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .hero-tag {
    margin: 0;
    max-width: var(--measure);
    color: var(--muted);
  }

  .column-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-unit);
    border-bottom: 2px solid var(--rule-color);
    padding-bottom: var(--space-unit);
    margin-bottom: calc(var(--space-unit) * 2);
  }
  .column-header h2 {
    margin: 0;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .column-more {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    text-transform: lowercase;
  }
  .column-more:hover,
  .column-more:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .empty {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--space-unit) * 2);
  }
  @media (min-width: 56rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
      gap: calc(var(--space-unit) * 3);
    }
  }
  .cards-item {
    display: block;
  }
  .hero-tag a {
    color: var(--accent);
  }
</style>
