---
/**
 * E3 — About (U-25 partial — content port).
 *
 * Content ported from legacy Jekyll `about.markdown` without semantic loss:
 *   - Three paragraphs (intro, generalist framing, blog goals)
 *   - Two outbound links: Twitter, LinkedIn (preserve hrefs verbatim)
 *
 * The Jekyll file itself is retired in E8 (Migration & SEO Cutover); this
 * route is the new canonical /about/.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
---
<BaseLayout
  title="About — Ryan Henderson"
  description="Ryan Henderson — consultant and software developer in Houston, Texas. About this blog and how to get in touch."
  canonicalPath="/about/"
>
  <article class="about prose">
    <header class="about-header">
      <p class="about-eyebrow">about</p>
      <h1>Ryan Henderson</h1>
    </header>
    <p>
      Hi! My name is Ryan Henderson, and I'm a consultant and software
      developer. I have been in this industry since graduating college in 2010.
      I live and work in Houston, Texas.
    </p>
    <p>
      Most of my experience is in the .NET world, but I consider myself a
      <em>generalist</em> and I've done many things across the spectrum. I
      consider myself a problem solver, and I seek out new and novel problems
      to solve daily.
    </p>
    <p>
      My goal for this blog is to share my point of view formed through my
      work as a consultant, comment on general industry trends, share solutions
      to specific problems I've solved, and whatever else comes along.
    </p>
    <p>
      If you want to get in contact, don't hesitate to reach out to me on
      <a href="https://twitter.com/htxryan" rel="me">Twitter</a>
      or
      <a href="https://www.linkedin.com/in/htxryan" rel="me">LinkedIn</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .about-header {
    border-bottom: var(--rule-hairline) solid var(--rule-color);
    padding-bottom: calc(var(--space-unit) * 2);
    margin-bottom: calc(var(--space-unit) * 4);
  }
  .about-eyebrow {
    margin: 0 0 calc(var(--space-unit));
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .about h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw + 1rem, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
</style>
