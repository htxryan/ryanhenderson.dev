---
/**
 * E4 — Post archive (`/posts/`).
 *
 * Chronological list of every published post (drafts excluded in prod via
 * `getPublishedPosts()` defaults). Same row pattern as the home page's
 * "Recent writing" column — a hairline-separated list, mono metadata,
 * lowercase chrome — but unbounded length.
 *
 * Performance: zero client JS shipped from this route (W-1).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPublishedPosts } from "~/lib/content";

const posts = await getPublishedPosts();

const fmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "2-digit",
  timeZone: "UTC",
});
---
<BaseLayout
  title="Writing — Ryan Henderson"
  description="All posts on consulting, software, and the work — chronological."
  canonicalPath="/posts/"
>
  <section class="archive" aria-labelledby="archive-heading">
    <header class="archive-header">
      <p class="archive-eyebrow">writing</p>
      <h1 id="archive-heading">All posts</h1>
      <p class="archive-count">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
    </header>
    {posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="rows">
        {posts.map((post) => (
          <li class="row">
            <a class="row-link" href={`/posts/${post.id}/`}>
              <time class="row-meta" datetime={post.data.pubDate.toISOString()}>
                {fmt.format(post.data.pubDate)}
              </time>
              <span class="row-title">{post.data.title}</span>
            </a>
            <p class="row-summary">{post.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .archive-header {
    border-bottom: calc(var(--rule-hairline) * 2) solid var(--rule-color);
    padding-bottom: calc(var(--space-unit) * 2);
    margin-bottom: calc(var(--space-unit) * 4);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: calc(var(--space-unit) * 2);
    align-items: baseline;
  }
  .archive-eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 var(--space-unit);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .archive-header h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw + 1rem, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .archive-count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    text-transform: lowercase;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    border-bottom: var(--rule-hairline) solid var(--rule-color);
    padding: calc(var(--space-unit) * 2) 0;
  }
  .row:last-child {
    border-bottom: 0;
  }
  .row-link {
    display: grid;
    grid-template-columns: minmax(8.5rem, auto) 1fr;
    gap: calc(var(--space-unit) * 2);
    align-items: baseline;
    text-decoration: none;
    color: var(--ink);
  }
  .row-link:hover .row-title,
  .row-link:focus-visible .row-title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    text-transform: lowercase;
    white-space: nowrap;
  }
  .row-title {
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .row-summary {
    margin: calc(var(--space-unit) * 0.5) 0 0;
    padding-left: calc(8.5rem + var(--space-unit) * 2);
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: var(--measure);
  }
  .empty {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }
  @media (max-width: 40rem) {
    .row-link {
      grid-template-columns: 1fr;
      gap: calc(var(--space-unit) * 0.5);
    }
    .row-summary {
      padding-left: 0;
    }
  }
</style>
