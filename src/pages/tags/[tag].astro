---
/**
 * E6 — Tag archive (`/tags/<tag>/`).
 *
 * `getStaticPaths` enumerates the union of tag values across BOTH content
 * collections — posts and projects — so a tag used on either surface is
 * routable. Each archive page lists posts AND projects under the tag.
 *
 * Tag matching is CASE-INSENSITIVE (normalised to lower-case). A post tagged
 * `TypeScript` and a project tagged `typescript` collapse to the single
 * archive `/tags/typescript/`. Authors should still keep the canonical
 * spelling consistent in frontmatter — the URL slug is always lowercase.
 *
 * Implicit contract: renaming a tag in one collection without also updating
 * the other orphans the archive's view of the renamed entry. There is no
 * runtime enforcement; authors must keep tag names consistent across blog
 * frontmatter and project frontmatter.
 *
 * Performance: zero client JS shipped from this route (W-1).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import { getPublishedPosts, getPublishedProjects } from "~/lib/content";
import { SITE_NAME } from "~/lib/site-meta";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  // `getStaticPaths` runs in an isolated module context — module-scope
  // helpers declared in this file are not in scope here, so the
  // lower-case normalisation is inlined.
  const [posts, projects] = await Promise.all([
    getPublishedPosts(),
    getPublishedProjects(),
  ]);

  const allTags = new Set<string>();
  for (const post of posts)
    for (const t of post.data.tags) allTags.add(t.toLowerCase());
  for (const proj of projects)
    for (const t of proj.data.tags) allTags.add(t.toLowerCase());

  return [...allTags].map((tag) => {
    const taggedPosts = posts.filter((p) =>
      p.data.tags.some((t: string) => t.toLowerCase() === tag),
    );
    const taggedProjects = projects.filter((p) =>
      p.data.tags.some((t: string) => t.toLowerCase() === tag),
    );
    return {
      params: { tag },
      props: { tag, posts: taggedPosts, projects: taggedProjects },
    };
  });
}

interface Props {
  tag: string;
  posts: CollectionEntry<"blog">[];
  projects: CollectionEntry<"projects">[];
}

const { tag, posts, projects } = Astro.props;

const fmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "2-digit",
  timeZone: "UTC",
});

const totalCount = posts.length + projects.length;
---
<BaseLayout
  title={SITE_NAME}
  description={`Posts and projects tagged #${tag}.`}
  canonicalPath={`/tags/${tag}/`}
>
  <section class="archive" aria-labelledby="archive-heading">
    <header class="archive-header">
      <p class="archive-eyebrow">tag</p>
      <h1 id="archive-heading">#{tag}</h1>
      <p class="archive-count">
        {totalCount} {totalCount === 1 ? "entry" : "entries"}
      </p>
    </header>

    {posts.length > 0 && (
      <section class="block" aria-labelledby="posts-heading">
        <h2 id="posts-heading" class="block-heading">Posts</h2>
        <ul class="rows">
          {posts.map((post) => (
            <li class="row">
              <a class="row-link" href={`/posts/${post.id}/`}>
                <time class="row-meta" datetime={post.data.pubDate.toISOString()}>
                  {fmt.format(post.data.pubDate)}
                </time>
                <span class="row-title">{post.data.title}</span>
              </a>
              <p class="row-summary">{post.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {projects.length > 0 && (
      <section class="block" aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="block-heading">Projects</h2>
        <ul class="cards" role="list">
          {projects.map((project) => (
            <li class="cards-item">
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {totalCount === 0 && (
      <p class="empty">No entries tagged #{tag}.</p>
    )}
  </section>
</BaseLayout>

<style>
  .archive-header {
    border-bottom: calc(var(--rule-hairline) * 2) solid var(--rule-color);
    padding-bottom: calc(var(--space-unit) * 2);
    margin-bottom: calc(var(--space-unit) * 4);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: calc(var(--space-unit) * 2);
    align-items: baseline;
  }
  .archive-eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 var(--space-unit);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .archive-header h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw + 1rem, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-family: var(--font-mono);
  }
  .archive-count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    text-transform: lowercase;
  }
  .block + .block {
    margin-top: calc(var(--space-unit) * 5);
  }
  .block-heading {
    margin: 0 0 calc(var(--space-unit) * 2);
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 2px solid var(--rule-color);
    padding-bottom: var(--space-unit);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    border-bottom: var(--rule-hairline) solid var(--rule-color);
    padding: calc(var(--space-unit) * 2) 0;
  }
  .row:last-child {
    border-bottom: 0;
  }
  .row-link {
    display: grid;
    grid-template-columns: minmax(8.5rem, auto) 1fr;
    gap: calc(var(--space-unit) * 2);
    align-items: baseline;
    text-decoration: none;
    color: var(--ink);
  }
  .row-link:hover .row-title,
  .row-link:focus-visible .row-title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    text-transform: lowercase;
    white-space: nowrap;
  }
  .row-title {
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .row-summary {
    margin: calc(var(--space-unit) * 0.5) 0 0;
    padding-left: calc(8.5rem + var(--space-unit) * 2);
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: var(--measure);
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--space-unit) * 2);
  }
  @media (min-width: 56rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
      gap: calc(var(--space-unit) * 3);
    }
  }
  .cards-item {
    display: block;
  }
  .empty {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }
  @media (max-width: 40rem) {
    .row-link {
      grid-template-columns: 1fr;
      gap: calc(var(--space-unit) * 0.5);
    }
    .row-summary {
      padding-left: 0;
    }
  }
</style>
