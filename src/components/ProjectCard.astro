---
/**
 * ProjectCard.
 *
 * Reused on the home page ("Featured work") and on `/work/` (portfolio
 * index). Single source of truth for project preview markup — no divergence
 * between contexts.
 *
 * Composition:
 *   - Status badge (data-status="active|archived") for token-driven styling
 *   - Title links DIRECTLY to the project's marketing site (or repo, if no
 *     marketing site). Opens in a new tab. There is no `/work/<slug>/`
 *     detail route — see src/pages/work/_[slug].astro for the disabled file.
 *     Projects without a public URL render a plain title without an arrow.
 *   - One-liner sits inside the card so the row stays self-describing
 *   - A secondary "repo →" button appears only when the project has BOTH a
 *     marketing site (where the title points) AND a repo (separate target).
 *
 * Outbound links: `target="_blank"` with `rel="noreferrer"` so the destination
 * cannot read the referrer. (No tracking; this is the safe default.)
 */
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, oneLiner, status, marketingUrl, repoUrl } = project.data;
// Title prefers the marketing site, then a public repo, or remains plain text.
const primaryUrl = marketingUrl ?? repoUrl;
// Show the secondary repo button only when the title and the repo are
// pointing at different things — otherwise the button duplicates the title.
const showRepoButton = !!repoUrl && primaryUrl !== repoUrl;
// Status enum uses kebab-case (e.g. `coming-soon`); the human-readable
// badge label substitutes spaces for hyphens.
const statusLabel = status.replace(/-/g, " ");
---
<article class="project-card" data-status={status}>
  <header class="project-card-header">
    <span class="project-card-status" data-status={status}>{statusLabel}</span>
    <h3 class="project-card-title">
      {primaryUrl ? (
        <a href={primaryUrl} target="_blank" rel="noreferrer">{name} ↗</a>
      ) : name}
    </h3>
  </header>
  <p class="project-card-oneliner">{oneLiner}</p>
  {showRepoButton ? (
    <div class="project-card-actions">
      <a
        class="project-card-action secondary"
        href={repoUrl}
        target="_blank"
        rel="noreferrer"
        data-repo-link
      >
        repo →
      </a>
    </div>
  ) : null}
</article>

<style>
  .project-card {
    display: grid;
    gap: var(--space-unit);
    border: var(--rule-hairline) solid var(--rule-color);
    padding: calc(var(--space-unit) * 2);
    background: var(--paper);
  }
  .project-card-header {
    display: grid;
    gap: calc(var(--space-unit) * 0.5);
  }
  .project-card-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    align-self: start;
    border: var(--rule-hairline) solid var(--rule-color);
    padding: 0.1em 0.5em;
    width: max-content;
  }
  .project-card-status[data-status="active"] {
    color: var(--accent);
    border-color: var(--accent);
  }
  /* "coming soon" gets the accent treatment too — these projects aren't
     live yet, but they ARE the highlight on the page. */
  .project-card-status[data-status="coming-soon"] {
    color: var(--accent);
    border-color: var(--accent);
  }
  .project-card-status[data-status="archived"] {
    color: var(--muted);
    border-color: var(--rule-color);
  }
  .project-card-title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.1;
  }
  .project-card-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .project-card-title a:hover,
  .project-card-title a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .project-card-oneliner {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: var(--measure);
  }
  .project-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-unit);
    margin-top: calc(var(--space-unit) * 0.5);
  }
  .project-card-action {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: lowercase;
    text-decoration: none;
    border: var(--rule-hairline) solid var(--rule-color);
    padding: calc(var(--space-unit) * 0.5) var(--space-unit);
  }
  .project-card-action.primary {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .project-card-action.primary:hover,
  .project-card-action.primary:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }
  .project-card-action.secondary {
    color: var(--ink);
    background: transparent;
  }
  .project-card-action.secondary:hover,
  .project-card-action.secondary:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
